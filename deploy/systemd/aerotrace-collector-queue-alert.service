[Unit]
Description=AeroTrace Collector queue alert evaluator
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot

User=huning
Group=huning

WorkingDirectory=/home/huning/aerotrace

Environment=PYTHONDONTWRITEBYTECODE=1

StateDirectory=aerotrace-monitoring
StateDirectoryMode=0750

ExecStart=/usr/bin/python3 /home/huning/aerotrace/scripts/evaluate-collector-queue-alert.py --state-file /var/lib/aerotrace-monitoring/collector-queue-alert.json --event-outbox-dir /var/lib/aerotrace-monitoring/notification-outbox --repeat-after-sec 300 --checker-timeout-sec 10 --quiet-no-event

TimeoutStartSec=15s

UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
