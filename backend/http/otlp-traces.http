### 5. 지원하지 않는 Content-Type
POST {{baseUrl}}/v1/traces
Content-Type: text/plain
Authorization: Bearer {{apiKey}}

{}

> {%
    client.test("지원하지 않는 Content-Type은 OTLP 오류 응답을 반환한다", function () {
        client.assert(
            response.status === 415,
            "예상 상태는 415이지만 실제 상태는 "
            + response.status
        );

        client.assert(
            response.body.message === "Unsupported OTLP Content-Type",
            "예상하지 못한 message: "
            + response.body.message
        );

        client.assert(
            response.body.timestamp === undefined,
            "Spring 기본 오류 응답이 반환되면 안 된다"
        );

        client.assert(
            response.body.error === undefined,
            "Spring 기본 error 필드가 반환되면 안 된다"
        );
    });
%}

