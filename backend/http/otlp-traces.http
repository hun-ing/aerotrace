### 11. Event와 Link 파싱 및 저장
POST {{baseUrl}}/v1/traces
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{apiKey}}

{
  "resourceSpans": [
    {
      "resource": {
        "attributes": [
          {
            "key": "service.name",
            "value": {
              "stringValue": "event-link-test-service"
            }
          }
        ]
      },
      "scopeSpans": [
        {
          "scope": {
            "name": "event-link-test",
            "version": "1.0.0"
          },
          "spans": [
            {
              "traceId": "cccccccccccccccccccccccccccccccc",
              "spanId": "dddddddddddddddd",
              "name": "POST /orders",
              "kind": 2,
              "startTimeUnixNano": "1581452772000000321",
              "endTimeUnixNano": "1581452773000000789",
              "events": [
                {
                  "timeUnixNano": "1581452772500000000",
                  "name": "exception",
                  "attributes": [
                    {
                      "key": "exception.type",
                      "value": {
                        "stringValue": "java.lang.IllegalStateException"
                      }
                    },
                    {
                      "key": "exception.message",
                      "value": {
                        "stringValue": "주문 상태를 변경할 수 없습니다"
                      }
                    }
                  ],
                  "droppedAttributesCount": 0
                }
              ],
              "links": [
                {
                  "traceId": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
                  "spanId": "ffffffffffffffff",
                  "traceState": "vendor=value",
                  "attributes": [
                    {
                      "key": "messaging.operation.type",
                      "value": {
                        "stringValue": "receive"
                      }
                    }
                  ],
                  "droppedAttributesCount": 0,
                  "flags": 1
                }
              ],
              "status": {
                "code": 2,
                "message": "order processing failed"
              }
            }
          ]
        }
      ]
    }
  ]
}

