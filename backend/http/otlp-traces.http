### 9. 다양한 Attribute 자료형 파싱 및 저장
POST {{baseUrl}}/v1/traces
Content-Type: application/json
Accept: application/json
X-AeroTrace-Tenant-Id: {{tenantId}}
X-AeroTrace-Project-Id: {{projectId}}

{
  "resourceSpans": [
    {
      "resource": {
        "attributes": [
          {
            "key": "service.name",
            "value": {
              "stringValue": "attribute-test-service"
            }
          },
          {
            "key": "deployment.environment.name",
            "value": {
              "stringValue": "local"
            }
          },
          {
            "key": "host.cpu.count",
            "value": {
              "intValue": "4"
            }
          },
          {
            "key": "debug",
            "value": {
              "boolValue": true
            }
          },
          {
            "key": "sample.ratio",
            "value": {
              "doubleValue": 0.25
            }
          }
        ]
      },
      "scopeSpans": [
        {
          "scope": {
            "name": "attribute-test",
            "version": "1.0.0"
          },
          "spans": [
            {
              "traceId": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "spanId": "bbbbbbbbbbbbbbbb",
              "name": "GET /attributes",
              "kind": 2,
              "startTimeUnixNano": "1581452772000000321",
              "endTimeUnixNano": "1581452773000000789",
              "attributes": [
                {
                  "key": "http.request.method",
                  "value": {
                    "stringValue": "GET"
                  }
                },
                {
                  "key": "http.response.status_code",
                  "value": {
                    "intValue": "200"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}

> {%
    client.test("Attribute 요청은 200을 반환한다", function () {
        client.assert(
            response.status === 200,
            "예상 상태는 200이지만 실제 상태는 " + response.status
        );
    });
%}

