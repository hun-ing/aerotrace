### 17. 잘못된 Tenant UUID 헤더는 400 반환
POST {{baseUrl}}/v1/traces
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{apiKey}}

{}

> {%
    client.test("잘못된 Tenant UUID는 OTLP 오류 응답을 반환한다", function () {
        client.assert(
            response.status === 400,
            "예상 상태는 400이지만 실제 상태는 "
            + response.status
        );

        client.assert(
            response.body.message !== undefined,
            "message 필드가 필요하다"
        );

        client.assert(
            response.body.message.includes(
                "X-AeroTrace-Tenant-Id"
            ),
            "오류가 발생한 헤더 이름이 message에 필요하다"
        );

        client.assert(
            response.body.timestamp === undefined,
            "Spring 기본 오류 응답이 반환되면 안 된다"
        );

        client.assert(
            response.body.error === undefined,
            "Spring 기본 error 필드가 반환되면 안 된다"
        );
    });
%}

### 18. Authorization 헤더 누락은 401
POST {{baseUrl}}/v1/traces
Content-Type: application/json
Accept: application/json

{}

> {%
    client.test("Authorization 헤더 누락은 401을 반환한다", function () {
