# .gitignore (루트 디렉터리에 생성)

# 1. OS & IDE
.DS_Store
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj

# 2. Backend (Java / Spring Boot)
/backend/.gradle/
/backend/build/
/backend/bin/
/backend/out/
/backend/logs/

# 3. Frontend (Node.js / Next.js)
/frontend/node_modules/
/frontend/.next/
/frontend/out/
/frontend/dist/
/frontend/build/
/frontend/.env*.local

# Cloudflare Slack receiver
/receiver/cloudflare-slack/node_modules/
/receiver/cloudflare-slack/.wrangler/
/receiver/cloudflare-slack/.dev.vars
/receiver/cloudflare-slack/.env

http-client.private.env.json

# Local runtime secrets
/.env
/otel-collector.env
/frontend.env

# Temporary Phase 9 snapshots
/phase9-*.zip
# Python cache
__pycache__/
*.py[cod]
