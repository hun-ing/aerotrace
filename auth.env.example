# Backend only; opt-in via docker-compose.auth.yaml. Never commit the populated auth.env.
SPRING_PROFILES_ACTIVE=auth-local
AEROTRACE_PUBLIC_ORIGIN=http://127.0.0.1:3000
AEROTRACE_GITHUB_CLIENT_ID=replace-with-local-oauth-app-client-id
AEROTRACE_GITHUB_CLIENT_SECRET=replace-with-local-oauth-app-client-secret
